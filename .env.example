# =============================================================================
# Modèle d'environnement — copier vers .env à la racine (le .env est ignoré par Git)
#   PowerShell: Copy-Item .env.example .env
# Docker Compose lit automatiquement le fichier .env pour ${VAR} dans docker-compose.yml
# =============================================================================

# --- Obligatoire pour docker compose (mots de passe / JWT injectés dans les services) ---
POSTGRES_USER=whatsapp
# Éviter @ : / ? # dans le mot de passe (réservés dans une URL), sauf encodage.
POSTGRES_PASSWORD=remplacez-par-un-mot-de-passe-local-fort

# Même valeur partout : api-gateway, auth-service, chat-service, user-service
JWT_SECRET=remplacez-par-une-chaine-longue-aleatoire-minimum-32-caracteres

# --- Optionnel (valeurs par défaut dans le code si absent) ---
APP_ENV=dev
ACCESS_TOKEN_TTL=24h
REFRESH_TOKEN_TTL=720h

# Redis : en compose, le service s'appelle "redis" (déjà défini dans docker-compose pour user-service)
# REDIS_ADDR=redis:6379

# --- Hors Docker Compose : lancer les binaires avec `go run` sur la machine hôte ---
# Dans ce cas, définir DATABASE_URL (ou SHARD_URLS) vous-même ; avec Compose ce n'est pas nécessaire
# (les URLs sont construites à partir de POSTGRES_USER / POSTGRES_PASSWORD).
# Exemple local shard 0 :
# DATABASE_URL=postgres://whatsapp:VOTRE_MDP@localhost:5433/whatsapp_shard_0?sslmode=disable

# Ports (défauts dans le code si non définis)
# API_GATEWAY_PORT=8080
# USER_SERVICE_PORT=8081
# MESSAGE_SERVICE_PORT=8082
# NOTIFICATION_SERVICE_PORT=8083
# AUTH_SERVICE_PORT=8084

# URLs microservices pour l'API Gateway (localhost si go run séparé ; noms de service si tout en compose)
# USER_SERVICE_URL=http://localhost:8081
# MESSAGE_SERVICE_URL=http://localhost:8082
# NOTIFICATION_SERVICE_URL=http://localhost:8083
# AUTH_SERVICE_URL=http://localhost:8084
# CHAT_SERVICE_URL=http://localhost:8088
#
# En compose, le compose fixe déjà les *_SERVICE_URL internes ; pas besoin de les dupliquer dans .env sauf override.
