# ===========================================
# Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
#   cp .env.sample .env
# ===========================================

# --- Base de données PostgreSQL ---
DATABASE_URL=postgres://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>?sslmode=disable
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Authentification JWT ---
# IMPORTANT : utiliser un secret fort et unique en production (min. 32 caractères)
JWT_SECRET=
ACCESS_TOKEN_TTL=24h
REFRESH_TOKEN_TTL=720h

# --- Ports des services ---
API_GATEWAY_PORT=8080
USER_SERVICE_PORT=8081
MESSAGE_SERVICE_PORT=8082
NOTIFICATION_SERVICE_PORT=8083
AUTH_SERVICE_PORT=8084

# --- URLs des microservices (utilisées par l'API Gateway) ---
# En local :
USER_SERVICE_URL=http://localhost:8081
MESSAGE_SERVICE_URL=http://localhost:8082
NOTIFICATION_SERVICE_URL=http://localhost:8083
AUTH_SERVICE_URL=http://localhost:8084
# Avec Docker Compose, utiliser les noms de services :
# USER_SERVICE_URL=http://user-service:8081
# MESSAGE_SERVICE_URL=http://message-service:8082
# NOTIFICATION_SERVICE_URL=http://notification-service:8083
# AUTH_SERVICE_URL=http://auth-service:8084
